ARG BASE_IMAGE=vpy-api4-vs79-validation:latest
FROM ${BASE_IMAGE}

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libboost-dev \
        ocl-icd-opencl-dev \
        opencl-headers \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir build
